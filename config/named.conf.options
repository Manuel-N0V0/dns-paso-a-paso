acl "confiables" {
    127.0.0.1;
    192.168.56.0/24;
};

options {
    directory "/var/cache/bind";

    recursion yes;
    allow-recursion { confiables; };
    allow-transfer { none; };

    listen-on port 53 {
        127.0.0.1;
        192.168.56.10;
    };

    // listen-on-v6 { any; };

    dnssec-validation yes;
};
